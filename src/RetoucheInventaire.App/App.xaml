<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RetoucheInventaire.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Gros boutons utilisables au doigt (au moins 64 px de haut). -->
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="AccentToolButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <!--
                Champ posé sur la page : gabarit minimal, sans bordure, marge, bouton « effacer »
                ni états visuels, pour que sa taille soit exactement celle de la case.
            -->
            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="Times New Roman" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="AcceptsReturn" Value="False" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="IsTextPredictionEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}">
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"
                                    ZoomMode="Disabled"
                                    IsTabStop="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
