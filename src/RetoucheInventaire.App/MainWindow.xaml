<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RetoucheInventaire.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Retouche d'inventaire">

    <!-- Même écran que sur iPhone/iPad : projet et pages en haut, la page au milieu, les outils en bas. -->
    <Grid x:Name="Root" Background="#FFEEF0F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre du haut : projet, navigation entre les pages (« 3 / 10 »), état de l'enregistrement. -->
        <Grid Grid.Row="0" Padding="10,6" ColumnSpacing="8" Background="#FFFAFBFC" BorderBrush="#FFDFE2E6" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ProjectButton" HorizontalAlignment="Left" MinHeight="44" MaxWidth="360" CornerRadius="22" Padding="12,4"
                    ToolTipService.ToolTip="Projet : nouveau, ouvrir, enregistrer, renommer">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE700;" FontSize="18" />
                    <TextBlock x:Name="ProjectName" Text="Inventaire" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem x:Name="NewItem" Text="Nouveau projet" Click="New_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="OpenItem" Text="Ouvrir un projet…" Click="Open_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveItem" Text="Enregistrer sous…" Click="Save_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="RenameItem" Text="Renommer" Click="Rename_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <StackPanel x:Name="Pager" Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <Button x:Name="PagePrev" Style="{StaticResource RoundButton}" Click="PagePrev_Click" ToolTipService.ToolTip="Page précédente (Page préc.)">
                    <FontIcon Glyph="&#xE76B;" FontSize="16" />
                </Button>
                <Button x:Name="PageLabel" Style="{StaticResource PillButton}" MinWidth="96" Click="PageLabel_Click"
                        FontSize="17" Content="1 / 1" ToolTipService.ToolTip="Liste des pages" />
                <Button x:Name="PageNext" Style="{StaticResource RoundButton}" Click="PageNext_Click" ToolTipService.ToolTip="Page suivante (Page suiv.)">
                    <FontIcon Glyph="&#xE76C;" FontSize="16" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="SaveState" Grid.Column="2" FontSize="13" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Une seule page à la fois. Pincer pour zoomer. -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="1"
                      ZoomMode="Enabled" MinZoomFactor="0.15" MaxZoomFactor="4"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PagesPanel" Spacing="8" Padding="16" HorizontalAlignment="Center" />
        </ScrollViewer>
        <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Spacing="10" Padding="24">
            <Image x:Name="EmptyIcon" Width="96" Height="96" />
            <TextBlock Text="Retouche d'inventaire" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock FontSize="18" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Touchez « Photo » pour photographier un inventaire, ou « Importer » pour ouvrir une photo, un PDF, un fichier texte ou un tableur." />
            <TextBlock FontSize="16" Opacity="0.65" TextWrapping="Wrap" TextAlignment="Center" Text="Tout reste sur la tablette, même sans Internet." />
        </StackPanel>

        <!-- Barre contextuelle : case sélectionnée. -->
        <Grid x:Name="EditBar" Grid.Row="2" Padding="12,6" ColumnSpacing="8" Background="White" BorderBrush="#FFDFE2E6" BorderThickness="0,1,0,0"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="EditInfo" FontSize="14" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="KindButton" Grid.Column="1" Style="{StaticResource PillButton}" Click="Kind_Click"
                    ToolTipService.ToolTip="Article, titre, total, en-tête ou non exportée">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8EC;" FontSize="16" />
                    <TextBlock x:Name="KindButtonText" Text="Article" />
                </StackPanel>
            </Button>
            <Button x:Name="RevertButton" Grid.Column="2" Style="{StaticResource PillButton}" Click="Revert_Click"
                    ToolTipService.ToolTip="Remettre le texte d'origine dans la case">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                    <TextBlock Text="Rétablir" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Ligne d'état, progression, zoom. -->
        <Grid Grid.Row="3" Padding="12,6" ColumnSpacing="10" Background="#FFFAFBFC" BorderBrush="#FFDFE2E6" BorderThickness="0,1,0,0" MinHeight="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ProgressBar x:Name="Progress" Grid.Column="1" Width="180" Minimum="0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Style="{StaticResource RoundButton}" Width="38" Height="38" Click="ZoomOut_Click" ToolTipService.ToolTip="Dézoomer">
                    <FontIcon Glyph="&#xE71F;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource RoundButton}" Width="38" Height="38" Click="ZoomFit_Click" ToolTipService.ToolTip="Ajuster à la largeur">
                    <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource RoundButton}" Width="38" Height="38" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoomer">
                    <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Barre d'outils du bas : grosses cibles pour le doigt, mêmes outils que sur iPhone/iPad. -->
        <Grid Grid.Row="4" Padding="6" ColumnSpacing="4" Background="#FFFAFBFC" BorderBrush="#FFDFE2E6" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="170" />
                <ColumnDefinition Width="*" MaxWidth="170" />
                <ColumnDefinition Width="*" MaxWidth="170" />
                <ColumnDefinition Width="*" MaxWidth="170" />
                <ColumnDefinition Width="*" MaxWidth="170" />
                <ColumnDefinition Width="*" MaxWidth="170" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PhotoButton" Grid.Column="0" Style="{StaticResource AccentTabButton}" Click="Photo_Click"
                    ToolTipService.ToolTip="Photographier un inventaire avec la caméra de la tablette">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE722;" FontSize="20" />
                    <TextBlock Text="Photo" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="ImportButton" Grid.Column="1" Style="{StaticResource TabButton}" Click="Import_Click"
                    ToolTipService.ToolTip="Photos, PDF, TXT, CSV, XLSX ou projet .inventaire">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B5;" FontSize="20" />
                    <TextBlock Text="Importer" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="LotsButton" Grid.Column="2" Style="{StaticResource TabButton}" Click="Lots_Click"
                    ToolTipService.ToolTip="Numéros de lot : un par objet, dans une colonne à gauche">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8EF;" FontSize="20" />
                    <TextBlock Text="Lots" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="CropButton" Grid.Column="3" Style="{StaticResource TabButton}" Click="Crop_Click"
                    ToolTipService.ToolTip="Recadrer la page affichée">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A8;" FontSize="20" />
                    <TextBlock Text="Recadrer" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ToggleButton x:Name="LockToggle" Grid.Column="4" Style="{StaticResource TabToggle}" Checked="LockToggle_Changed" Unchecked="LockToggle_Changed"
                          ToolTipService.ToolTip="Tracer une zone (signature, tampon) qui ne pourra pas être modifiée">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="20" />
                    <TextBlock Text="Verrouiller" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Button x:Name="ExportButton" Grid.Column="5" Style="{StaticResource AccentTabButton}"
                    ToolTipService.ToolTip="Images JPEG ou fichier texte">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72D;" FontSize="20" />
                    <TextBlock Text="Exporter" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight" Opening="ExportMenu_Opening">
                        <MenuFlyoutItem x:Name="ExportAllJpegItem" Text="Toutes les images JPEG" Click="ExportJpeg_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExportOneJpegItem" Text="Image de cette page seulement" Click="ExportOneJpeg_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ExportTxtItem" Text="Fichier texte (.txt)" Click="ExportTxt_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Recadrage à la main : 4 poignées à déplacer au doigt. -->
        <Grid x:Name="CropOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#F01E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox x:Name="CropViewbox" Margin="32" Stretch="Uniform" SizeChanged="CropViewbox_SizeChanged">
                <Canvas x:Name="CropCanvas">
                    <Image x:Name="CropImage" Stretch="Fill" />
                    <Polygon x:Name="CropPolygon" Stroke="#FF3D8BFF" Fill="#223D8BFF" />
                </Canvas>
            </Viewbox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Padding="12">
                <Button Style="{StaticResource ToolButton}" Click="CropRotate_Click" Content="Pivoter ↻" />
                <Button Style="{StaticResource ToolButton}" Click="CropAuto_Click" Content="Détection auto" />
                <Button Style="{StaticResource ToolButton}" Click="CropFull_Click" Content="Page entière" />
                <Button Style="{StaticResource ToolButton}" Click="CropCancel_Click" Content="Annuler" />
                <Button Style="{StaticResource AccentToolButton}" Click="CropApply_Click" Content="Valider" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
