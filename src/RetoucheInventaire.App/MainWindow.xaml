<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RetoucheInventaire.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Retouche d'inventaire">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre d'outils : un seul écran, gros boutons pour le doigt. -->
        <ScrollViewer Grid.Row="0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Spacing="6" Padding="8">
                <Button x:Name="ImportButton" Style="{StaticResource AccentToolButton}" Click="Import_Click"
                        ToolTipService.ToolTip="Photos, PDF, TXT, CSV ou XLSX">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE8B5;" FontSize="20" />
                        <TextBlock Text="Importer" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CropButton" Style="{StaticResource ToolButton}" Click="Crop_Click"
                        ToolTipService.ToolTip="Recadrer la page touchée en dernier">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE7A8;" FontSize="20" />
                        <TextBlock Text="Recadrer" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="LockToggle" Style="{StaticResource ToolToggle}" Checked="LockToggle_Changed" Unchecked="LockToggle_Changed"
                              ToolTipService.ToolTip="Tracer une zone (signature, tampon) qui ne pourra pas être modifiée">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE72E;" FontSize="20" />
                        <TextBlock Text="Verrouiller" HorizontalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="KindButton" Style="{StaticResource ToolButton}" Click="Kind_Click" MinWidth="140"
                        ToolTipService.ToolTip="Article, titre, total, en-tête ou non exportée">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE8FD;" FontSize="20" />
                        <TextBlock x:Name="KindButtonText" Text="Type de ligne" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RevertButton" Style="{StaticResource ToolButton}" Click="Revert_Click"
                        ToolTipService.ToolTip="Remettre le texte d'origine dans la case sélectionnée">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE7A7;" FontSize="20" />
                        <TextBlock Text="Rétablir" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Margin="6,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button x:Name="ExportButton" Style="{StaticResource AccentToolButton}" Click="ExportTxt_Click"
                        ToolTipService.ToolTip="Fichier texte : une ligne par ligne, colonnes séparées par des tabulations">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xEDE1;" FontSize="20" />
                        <TextBlock Text="Exporter .txt" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Click="Save_Click">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE74E;" FontSize="20" />
                        <TextBlock Text="Enregistrer" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Click="Open_Click">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE8E5;" FontSize="20" />
                        <TextBlock Text="Ouvrir" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewButton" Style="{StaticResource ToolButton}" Click="New_Click">
                    <StackPanel Spacing="2">
                        <FontIcon Glyph="&#xE710;" FontSize="20" />
                        <TextBlock Text="Nouveau" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Les pages, l'une sous l'autre. Pincer pour zoomer. -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="1"
                      ZoomMode="Enabled" MinZoomFactor="0.2" MaxZoomFactor="4"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
            <StackPanel x:Name="PagesPanel" Spacing="28" Padding="24" HorizontalAlignment="Center">
                <TextBlock x:Name="EmptyHint" FontSize="20" TextWrapping="Wrap" MaxWidth="600" Margin="0,80,0,0" TextAlignment="Center"
                           Text="Touchez « Importer » pour ouvrir une photo, un PDF, un fichier texte ou un tableur. Rien ne quitte la tablette." />
            </StackPanel>
        </ScrollViewer>

        <!-- Barre d'état -->
        <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" Width="24" Height="24" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="SaveState" Grid.Column="2" FontSize="14" VerticalAlignment="Center" Opacity="0.75" />
        </Grid>

        <!-- Recadrage à la main : 4 poignées à déplacer au doigt. -->
        <Grid x:Name="CropOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#F01E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox x:Name="CropViewbox" Margin="32" Stretch="Uniform" SizeChanged="CropViewbox_SizeChanged">
                <Canvas x:Name="CropCanvas">
                    <Image x:Name="CropImage" Stretch="Fill" />
                    <Polygon x:Name="CropPolygon" Stroke="#FF3D8BFF" Fill="#223D8BFF" />
                </Canvas>
            </Viewbox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Padding="12">
                <Button Style="{StaticResource ToolButton}" Click="CropRotate_Click" Content="Pivoter ↻" />
                <Button Style="{StaticResource ToolButton}" Click="CropAuto_Click" Content="Détection auto" />
                <Button Style="{StaticResource ToolButton}" Click="CropFull_Click" Content="Page entière" />
                <Button Style="{StaticResource ToolButton}" Click="CropCancel_Click" Content="Annuler" />
                <Button Style="{StaticResource AccentToolButton}" Click="CropApply_Click" Content="Valider" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
